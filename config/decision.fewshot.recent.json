{
  "_comment": "kevcpp 诊断配置: 把决策示例放在最接近 answer 续写 token 的位置(最 recency, 见 arXiv:2104.08786 顺序影响)。{state} 因此前移, few-shot 段成为可变 tail 的一部分(前缀缓存只覆盖 instructions+options, 功能正确优先)。",
  "markers": {
    "state":        "<|fim_prefix|>",
    "question":     "<|fim_middle|>",
    "option_start": "<|box_start|>",
    "option_end":   "<|box_end|>",
    "decide":       "<|fim_suffix|>"
  },
  "temperature": 1.0,
  "logits": {
    "enable": true,
    "prompt_template": "{instructions}\n[ {options} ]\n{state}\n{fewshot}Answer:",
    "aggregation": "first",
    "logits_type": ""
  },
  "few_shot": {
    "enabled": true,
    "examples_file": "config/fewshot_cn.json"
  }
}