{
  "_comment": "kevcpp 决策配置: 在 logits 判别主通道启用 in-context 决策示例 (few-shot, 模型无关)。与 decision.qwen3.5.json 相同, 额外加 few_shot.{enabled,examples_file}。{state} 放在最后以保证稳定公共前缀(instructions+fewshot+options)可被 P2 前缀缓存复用。",
  "markers": {
    "state":        "<|fim_prefix|>",
    "question":     "<|fim_middle|>",
    "option_start": "<|box_start|>",
    "option_end":   "<|box_end|>",
    "decide":       "<|fim_suffix|>"
  },
  "temperature": 1.0,
  "logits": {
    "enable": true,
    "prompt_template": "{instructions}\n{fewshot}\n[ {options} ]\n{state}\nAnswer:",
    "aggregation": "first",
    "logits_type": ""
  },
  "few_shot": {
    "enabled": true,
    "examples_file": "config/fewshot_cn.json"
  }
}