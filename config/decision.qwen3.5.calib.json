{
  "_comment": "kevcpp 方案3 校准启用样例(opt-in, 默认不加载)。默认行为由 decision.qwen3.5.json 关闭校准。本清单为'诚实置信'取向: 单档 T=0.5(降低 ECE, 置信更贴真实正确率), 不启用位置去偏(校准集强增益但未泛化到测试集, 见报告), 低置信拒绝关闭。",
  "markers": {
    "state":        "<|fim_prefix|>",
    "question":     "<|fim_middle|>",
    "option_start": "<|box_start|>",
    "option_end":   "<|box_end|>",
    "decide":       "<|fim_suffix|>"
  },
  "temperature": 1.0,
  "logits": {
    "enable": true,
    "prompt_template": "{instructions}\n[ {options} ]\n{state}\nAnswer:",
    "aggregation": "first",
    "logits_type": ""
  },
  "calib": {
    "enable": true,
    "temperature_mode": "single",
    "temperature": 0.5,
    "position_debias": false,
    "drop_low_conf": 0.0
  }
}